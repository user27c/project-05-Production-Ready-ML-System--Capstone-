# 环境配置模板
# ==================================
# 本文件作为环境特定配置的模板。
# 复制此文件以创建环境特定的 .env 文件：
#   - .env.development（用于本地开发）
#   - .env.staging（用于预发布环境）
#   - .env.production（用于生产环境）
#
# 切勿将实际的 .env 文件提交到 Git！只提交此 .env.example 模板。

# ==============================================================================
# 环境配置
# ==============================================================================

# 环境名称：development, staging, production
ENVIRONMENT=development

# ==============================================================================
# 应用程序配置
# ==============================================================================

# 应用程序端口
PORT=5000

# 日志级别：DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# 日志格式：text, json
LOG_FORMAT=json

# ==============================================================================
# 机器学习模型配置
# ==============================================================================

# 模型名称（与 MLflow 中注册的名称一致）
MODEL_NAME=image-classifier

# 模型版本：特定版本号、"latest" 或阶段名称（"Production", "Staging"）
MODEL_VERSION=latest

# 模型框架：pytorch, tensorflow, sklearn
MODEL_FRAMEWORK=pytorch

# ==============================================================================
# MLFLOW 配置
# ==============================================================================

# MLflow 追踪服务器 URI
MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow 实验名称
MLFLOW_EXPERIMENT_NAME=development-experiments

# MLflow 模型注册表 URI（通常与追踪 URI 相同）
MLFLOW_REGISTRY_URI=http://localhost:5000

# ==============================================================================
# 数据库配置
# ==============================================================================

# PostgreSQL 连接（用于 MLflow 后端存储）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mlflow
DB_USER=mlflow
DB_PASSWORD=changeme_in_production

# 连接池设置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==============================================================================
# 对象存储配置
# ==============================================================================

# 存储类型：s3, minio, gcs, azure
STORAGE_TYPE=s3

# S3/MinIO 配置
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme_in_production
S3_BUCKET_NAME=ml-models
S3_REGION=us-west-2

# 对于 AWS S3，请留空 S3_ENDPOINT_URL 并设置：
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ==============================================================================
# 身份验证与安全配置
# ==============================================================================

# API 密钥（多个密钥用逗号分隔）
# 重要提示：在生产环境中请更改这些值！
API_KEYS=dev-test-key-123,dev-admin-key-456

# API 密钥头名称
API_KEY_HEADER=X-API-Key

# 启用身份验证
AUTHENTICATION_ENABLED=true

# CORS 设置
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# 监控与可观测性配置
# ==============================================================================

# Prometheus 指标
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PORT=5000

# 分布式追踪（可选）
TRACING_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# 应用程序性能监控（可选）
APM_ENABLED=false
APM_SERVICE_NAME=ml-api
APM_SERVER_URL=http://localhost:8200

# ==============================================================================
# 性能配置
# ==============================================================================

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 模型推理超时时间（秒）
INFERENCE_TIMEOUT=10

# 最大文件上传大小（字节）- 10MB
MAX_FILE_SIZE=10485760

# Worker 配置（用于 Gunicorn）
WORKERS=4
WORKER_CLASS=sync
WORKER_TIMEOUT=120
WORKER_CONNECTIONS=1000

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# ==============================================================================
# 限流配置
# ==============================================================================

# 全局限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# 各端点限流
PREDICT_RATE_LIMIT_PER_MINUTE=10
HEALTH_RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# KUBERNETES 配置（用于集群内应用程序）
# ==============================================================================

# Kubernetes 命名空间
K8S_NAMESPACE=ml-system-development

# 服务账户
K8S_SERVICE_ACCOUNT=ml-api-sa

# Pod 名称（由 Kubernetes 自动填充）
# POD_NAME=${POD_NAME}

# 节点名称（由 Kubernetes 自动填充）
# NODE_NAME=${NODE_NAME}

# ==============================================================================
# 特性开关
# ==============================================================================

# 启用实验性功能
ENABLE_EXPERIMENTAL_FEATURES=false

# 启用 A/B 测试
ENABLE_AB_TESTING=false

# 启动时启用模型预热
ENABLE_MODEL_WARMUP=true

# 启用响应缓存
ENABLE_RESPONSE_CACHE=false

# ==============================================================================
# 开发环境特定设置
# ==============================================================================
# 这些设置仅用于开发环境

# 启用调试模式（请勿在生产环境中使用！）
DEBUG=false

# 启用自动重载（仅用于开发）
AUTO_RELOAD=false

# 启用性能分析
ENABLE_PROFILING=false

# 模拟外部服务（用于测试）
MOCK_MLFLOW=false
MOCK_DATABASE=false

# ==============================================================================
# 预发布环境特定设置
# ==============================================================================
# 请取消注释并为预发布环境设置

# ENVIRONMENT=staging
# LOG_LEVEL=INFO
# MODEL_VERSION=staging
# MLFLOW_TRACKING_URI=https://mlflow-staging.example.com
# DB_HOST=postgres-staging.example.com
# S3_BUCKET_NAME=ml-models-staging

# ==============================================================================
# 生产环境特定设置
# ==============================================================================
# 请取消注释并为生产环境设置

# ENVIRONMENT=production
# LOG_LEVEL=WARN
# MODEL_VERSION=production
# MLFLOW_TRACKING_URI=https://mlflow.example.com
# DB_HOST=postgres.example.com
# S3_BUCKET_NAME=ml-models-production

# 重要的生产环境安全设置：
# - 更改所有默认密码和 API 密钥
# - 使用强壮的、随机生成的凭据
# - 将密钥存储在 Kubernetes Secrets 或 HashiCorp Vault 中
# - 切勿将生产凭据提交到 Git
# - 定期轮换凭据
# - 启用所有安全功能（身份验证、限流等）

# ==============================================================================
# 环境特定文件示例
# ==============================================================================

# .env.development 示例：
# ENVIRONMENT=development
# LOG_LEVEL=DEBUG
# DEBUG=true
# MLFLOW_TRACKING_URI=http://localhost:5000
# DB_PASSWORD=dev_password
# API_KEYS=dev-key-123

# .env.staging 示例：
# ENVIRONMENT=staging
# LOG_LEVEL=INFO
# DEBUG=false
# MLFLOW_TRACKING_URI=https://mlflow-staging.example.com
# DB_PASSWORD=staging_secure_password_here
# API_KEYS=staging-key-from-secrets

# .env.production 示例：
# ENVIRONMENT=production
# LOG_LEVEL=WARN
# DEBUG=false
# MLFLOW_TRACKING_URI=https://mlflow.example.com
# DB_PASSWORD=production_highly_secure_password
# API_KEYS=production-key-from-vault

# ==============================================================================
# 使用说明
# ==============================================================================

# 1. 复制此文件：
#    cp .env.example .env.development

# 2. 编辑 .env.development 设置您的本地配置

# 3. 加载环境变量：
#    对于 Bash/Zsh：
#      export $(cat .env.development | xargs)
#    或使用 python-dotenv：
#      from dotenv import load_dotenv
#      load_dotenv('.env.development')

# 4. 对于 Docker：
#    docker run --env-file .env.development your-image

# 5. 对于 docker-compose：
#    添加到 docker-compose.yml：
#      services:
#        app:
#          env_file: .env.development

# 6. 对于 Kubernetes：
#    从 .env 创建 ConfigMap：
#      kubectl create configmap app-config --from-env-file=.env.development
#    或使用外部密钥管理（生产环境推荐）

# ==============================================================================
# 安全最佳实践
# ==============================================================================

# ✅ 应该做的事：
# - 使用此模板创建环境特定的 .env 文件
# - 将生产环境密钥存储在密钥管理器中（Vault、AWS Secrets Manager）
# - 为每个环境使用不同的凭据
# - 定期轮换凭据
# - 使用强壮的、随机生成的密码
# - 启用身份验证和限流
# - 定期审查和审计环境变量

# ❌ 不应该做的事：
# - 将 .env 文件提交到 Git（添加到 .gitignore）
# - 在不同环境中使用相同的凭据
# - 在应用程序代码中硬编码密钥
# - 通过电子邮件或 Slack 共享生产凭据
# - 使用弱密码或默认密码
# - 在生产环境中启用调试模式
# - 在日志中暴露敏感配置

# ==============================================================================
# 故障排除
# ==============================================================================

# 如果环境变量没有加载：
# 1. 检查文件位置（.env 应该在项目根目录）
# 2. 验证没有语法错误（= 号周围不能有空格）
# 3. 检查文件编码（应该是 UTF-8）
# 4. 更改 .env 后重启应用程序
# 5. 检查应用程序是否配置为加载 .env 文件

# 如果密钥不工作：
# 1. 验证密钥值是否正确（末尾不能有空格）
# 2. 检查密钥管理系统（Vault、K8s Secrets）
# 3. 验证应用程序有权限访问密钥
# 4. 检查密钥编码（K8s Secrets 使用 base64）

# ==============================================================================
# 附加说明
# ==============================================================================

# - 环境变量会覆盖此文件中的值
# - 布尔值：使用 "true" 或 "false"（小写）
# - 数字值：无需引号
# - 字符串值：除非包含特殊字符，否则引号可选
# - 注释：在行首使用 #
# - 空值：留空或使用 ""（取决于您的解析器）

# 更多信息请参阅：
# - 项目文档：docs/CONFIGURATION.md
# - Twelve-Factor App 方法论：https://12factor.net/config
# - Docker 环境变量：https://docs.docker.com/compose/environment-variables/
